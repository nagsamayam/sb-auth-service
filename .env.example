APP_NAME="Auth Service"
SERVER_PORT=8080

# MYSQL
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_DATABASE=
MYSQL_DB_USERNAME=
MYSQL_DB_PASSWORD=
MYSQL_DB_URL="jdbc:mysql://${MYSQL_DB_HOST}:${MYSQL_DB_PORT}/${MYSQL_DB_DATABASE}"

# JWT
JWT_ISSUER=http://localhost:8080

JWT_ACTIVE_KEY_ID=auth-key-2026-v2
JWT_ACTIVE_PRIVATE_KEY=
JWT_ACITVE_PUBLIC_KEY=classpath:certs/public_key_v2.pem

# inactive keys
JWT_V1_KEY_ID=auth-key-2026
JWT_V1_PRIVATE_KEY=
JWT_V1_PUBLIC_KEY=classpath:certs/public_key.pem
# 15 minutes (in seconds) for Access Tokens
JWT_TTL=900
# 7 days (in seconds) for Refresh Tokens
JWT_REFRESH_TTL=604800

# Session - Refresh token
SESSION_REFRESH_TOKEN_COOKIE=refresh_token
SESSION_REFRESH_TOKEN_SECURE_COOKIE=false
SESSION_REFRESH_TOKEN_HTTP_ONLY=true
SESSION_REFRESH_TOKEN_SAME_SITE=lax
SESSION_REFRESH_TOKEN_PATH=/api
SESSION_REFRESH_TOKEN_LIFETIME=${JWT_REFRESH_TTL}

# Clean up refresh tokens
CLEANUP_REFRESH_TOKEN_CRON="0 0 3 * * *"

# OAUTH2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=